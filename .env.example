# Visual Campus -- environment variables.
# Copy this file to .env and fill in GEMINI_API_KEY (and CONTACT_EMAIL). Never commit .env.
# Everything below except GEMINI_API_KEY and CONTACT_EMAIL is optional.

# ---------------------------------------------------------------- AI (Gemini, Google AI Studio)
# The only key this project needs (free tier is enough). Get one at https://aistudio.google.com/apikey
# Without it the app still runs: every photo gets the vision_unavailable warning and can be
# at most "likely" (never "verified"), and the description falls back to Wikipedia text.
GEMINI_API_KEY=
# Model used for image-classification batches (probed against the live models list).
VISION_MODEL=gemini-3.5-flash-lite
# Model used for the description and spelling normalization. Empty = same as VISION_MODEL.
TEXT_MODEL=
# Fallback model with its own 15 requests/minute free-tier quota, used as soon as the primary
# model answers 429 (quota is counted per model). Empty = no fallback.
VISION_FALLBACK_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------- Optional photo sources (off by default)
# Flickr API key. Optional: without it the Flickr source is simply not used (geotagged photos
# come from the keyless Wikimedia Commons geosearch instead).
FLICKR_API_KEY=
# Optional Google Custom Search booster (100 queries/day). Both must be set to enable it;
# without them web search is silently skipped.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------- Identification
# Contact e-mail placed in the User-Agent (required by the Wikimedia API policy).
CONTACT_EMAIL=team@example.com

# ---------------------------------------------------------------- Runtime tuning
# Directory for the sqlite cache and the thumbnails (Docker: /app/data via WORKDIR).
CACHE_DIR=./data
# Profile cache TTL in hours (search cache is fixed at 6 h).
PROFILE_TTL_HOURS=24
# Hard wall-clock deadline for one profile build, seconds.
HARD_DEADLINE_S=27
# Vision batching: images per request / requests in flight (12 keeps one profile under the
# Gemini free-tier requests-per-minute quota; the spec default was 8).
VISION_BATCH_SIZE=12
VISION_CONCURRENCY=6
# Parallel image downloads (Wikimedia media hosts are additionally capped at 8).
DOWNLOAD_CONCURRENCY=16
# Max non-city candidates kept after normalization (city candidates are capped at 20).
MAX_CANDIDATES=120
# Comma-separated source names to disable for testing,
# e.g. "commons_category,commons_geo" (names: wikidata_p18, commons_category, commons_geo,
# flickr, commons_search, official_site, city_commons, web_search).
DISABLE_SOURCES=
# CORS origins for local development (the Vite dev server). Same-origin in production.
ALLOWED_ORIGINS=http://localhost:5173
# Python logging level.
LOG_LEVEL=INFO
# HTTP port for uvicorn.
PORT=8000
