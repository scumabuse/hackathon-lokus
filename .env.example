# Visual Campus -- environment variables.
# Copy this file to .env and fill in the keys. Never commit .env.

# ---------------------------------------------------------------- AI (Anthropic)
# Required for vision classification and campus descriptions.
# Without it the app still runs: every photo gets the vision_unavailable warning
# and can be at most "likely" (never "verified").
ANTHROPIC_API_KEY=
# Model used for image-classification batches (verified against the Anthropic models page).
VISION_MODEL=claude-haiku-4-5-20251001
# Model used for the description and spelling normalization. Empty = same as VISION_MODEL.
TEXT_MODEL=

# ---------------------------------------------------------------- Photo sources
# Flickr API key (https://www.flickr.com/services/apps/create/). Empty = Flickr source skipped
# with the warning "source_unavailable: flickr (no API key)".
FLICKR_API_KEY=
# Optional Google Custom Search booster (100 queries/day). Both must be set to enable it.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------- Identification
# Contact e-mail placed in the User-Agent (required by the Wikimedia API policy).
CONTACT_EMAIL=team@example.com

# ---------------------------------------------------------------- Runtime tuning
# Directory for the sqlite cache and the thumbnails (Docker: /app/data via WORKDIR).
CACHE_DIR=./data
# Profile cache TTL in hours (search cache is fixed at 6 h).
PROFILE_TTL_HOURS=24
# Hard wall-clock deadline for one profile build, seconds.
HARD_DEADLINE_S=27
# Vision batching: images per request / requests in flight.
VISION_BATCH_SIZE=8
VISION_CONCURRENCY=4
# Parallel image downloads (upload.wikimedia.org is additionally capped at 8).
DOWNLOAD_CONCURRENCY=16
# Max non-city candidates kept after normalization (city candidates are capped at 20).
MAX_CANDIDATES=120
# Comma-separated source names to disable for testing, e.g. "flickr,commons_category".
DISABLE_SOURCES=
# CORS origins for local development (the Vite dev server). Same-origin in production.
ALLOWED_ORIGINS=http://localhost:5173
# Python logging level.
LOG_LEVEL=INFO
# HTTP port for uvicorn.
PORT=8000
